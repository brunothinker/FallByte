                    ft.Icon(icon, size=40, color=COLOR_PRIMARY),
                    ft.Text(
                        t(title_key),
                        size=18,
                        weight=ft.FontWeight.BOLD,
                        color=COLOR_TEXT,
                    ),
                    ft.Text(
                        t(description_key),
                        size=12,
                        color=COLOR_SUBTEXT,
                        text_align=ft.TextAlign.CENTER,
