    def toggle_logs(e: ft.ControlEvent) -> None:
        """Toggles detail log container visibility.

        Args:
            e: The trigger control event instance.
        """
        log_container.visible = not log_container.visible
        btn_toggle_log.text = (
            t("log_btn_hide_logs")
            if log_container.visible
