    dialog = ft.AlertDialog(
        modal=True,
        title=ft.Row(
            [
                ft.Icon(ft.icons.ASSESSMENT, color=COLOR_PRIMARY),
                ft.Text(
                    t("log_dialog_title"),
                    size=18,
                    weight=ft.FontWeight.BOLD,
                    color=COLOR_TEXT,
                ),
            ],
            spacing=10,
        ),
        content=ft.Container(
